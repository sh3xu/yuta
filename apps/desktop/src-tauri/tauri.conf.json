{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yuta",
  "version": "0.1.0",
  "identifier": "com.yuta.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yuta",
        "width": 296,
        "height": 536,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "backgroundColor": "#00000000"
      },
      {
        "label": "settings",
        "title": "Yuta Settings",
        "width": 400,
        "height": 680,
        "resizable": true,
        "maximizable": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "backgroundColor": "#12151c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
